{
    "name": "ilbronza/clients",
    "description": "Client and supplier registry, destinations and referents for Laravel.",
    "license": "MIT",
    "authors": [
        {
            "name": "Davide Bronzini",
            "email": "davide_bronzini@hotmail.com",
            "homepage": "https://sistema.srl"
        }
    ],
    "homepage": "https://github.com/ilbronza/clients",
    "keywords": [
        "Laravel",
        "Clients"
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^9.52.21 || >=10.48",
        "spatie/laravel-medialibrary": ">=10.13",
        "ilbronza/accountmanager": "*",
        "ilbronza/addresses": "*",
        "ilbronza/buttons": "*",
        "ilbronza/category": "*",
        "ilbronza/contacts": "*",
        "ilbronza/crud": "*",
        "ilbronza/datatables": "*",
        "ilbronza/filecabinet": "*",
        "ilbronza/form": "*",
        "ilbronza/formfield": "*",
        "ilbronza/menu": "*",
        "ilbronza/notes": "*",
        "ilbronza/operators": "*",
        "ilbronza/payments": "*",
        "ilbronza/products": "*",
        "ilbronza/ukn": "*",
        "ilbronza/uikittemplate": "*",
        "ilbronza/warehouse": "*",
        "ilbronza/timeline": "*",
        "spatie/laravel-permission": ">=5.11",
        "spatie/laravel-activitylog": ">=4.0"
    },
    "require-dev": {
        "orchestra/testbench": ">=8.0",
        "phpunit/phpunit": ">=10.5"
    },
    "autoload": {
        "psr-4": {
            "IlBronza\\Clients\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IlBronza\\Clients\\Tests\\": "tests",
            "App\\": "tests/Fixtures/App/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "IlBronza\\Clients\\ClientsServiceProvider"
            ],
            "aliases": {
                "Clients": "IlBronza\\Clients\\Facades\\Clients"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:lint": "find src config database routes tests -name '*.php' -print0 | xargs -0 -n1 php -l"
    }
}
